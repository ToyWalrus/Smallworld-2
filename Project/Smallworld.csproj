<!-- <Project Sdk="Godot.NET.Sdk/4.2.0"> -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net7.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net8.0</TargetFramework> -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Scripts/Logic/FSM/**/*.cs" />
  </ItemGroup>
  <!-- <ItemGroup>
    <PackageReference Update="Godot.SourceGenerators" Version="4.2.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="GodotSharp" Version="4.2.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="GodotSharpEditor" Version="4.2.2" />
  </ItemGroup> -->
  <Target Name="CopyToUnity" AfterTargets="Build">
    <ItemGroup>
      <UnityPluginFiles Include="$(OutputPath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(UnityPluginFiles)"
          DestinationFolder="$(MSBuildProjectDirectory)/../Unity/Assets/Plugins/Smallworld" />
  </Target>
</Project>