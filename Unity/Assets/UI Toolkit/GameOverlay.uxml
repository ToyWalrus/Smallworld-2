<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PlayerButton" src="project://database/Assets/UI%20Toolkit/PlayerButton.uxml?fileID=9197481963319205126&amp;guid=a9f5c21ad9c6d11499f26008dc6e8003&amp;type=3#PlayerButton"/>
    <ui:Template name="RacePowerList" src="project://database/Assets/UI%20Toolkit/RacePowerList.uxml?fileID=9197481963319205126&amp;guid=6d06aaecfcab9dd4397f8ba3f6f083aa&amp;type=3#RacePowerList"/>
    <Style src="project://database/Assets/UI%20Toolkit/GameStyles.uss?fileID=7433441132597879392&amp;guid=65da4ba4461bdd047898d97d618e8b80&amp;type=3#GameStyles"/>
    <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;">
        <ui:VisualElement name="RPContainer">
            <ui:Instance template="RacePowerList"/>
        </ui:VisualElement>
        <ui:VisualElement name="PlayerContainer" style="flex-grow: 0; align-items: flex-end;">
            <ui:Instance template="PlayerButton" name="P1"/>
            <ui:Instance template="PlayerButton" name="P2"/>
            <ui:Instance template="PlayerButton" name="P3"/>
            <ui:Instance template="PlayerButton" name="P4"/>
        </ui:VisualElement>
        <ui:Button text="Start" name="StartGameButton" style="position: absolute; top: auto; left: auto; bottom: 16px; font-size: 38px; right: 16px;"/>
        <ui:VisualElement style="flex-grow: 1; position: absolute; bottom: 16px; left: 16px; align-items: flex-start; background-color: rgba(255, 255, 255, 0.53); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;">
            <ui:Label text="Game status" name="GameStatus" style="position: relative; font-size: 28px;"/>
            <ui:Label text="Game hint" name="GameHint" style="font-size: 22px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
