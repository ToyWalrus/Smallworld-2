:root {
}

.RPLabel {
    flex-grow: 0;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=48af136bb93de9b43a94e61c53b086ed&type=3#NotInter-Regular");
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(7, 7, 7);
    -unity-text-outline-color: rgba(219, 219, 219, 0.36);
    -unity-text-outline-width: 2px;
    white-space: pre-wrap;
}

.CenterFlex {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.FlowButton {
    font-size: 38px;
    background-image: resource("UI-pack_Sprite_1#UI-pack_Sprite_1_36");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(188, 188, 188, 0);
    padding-right: 20px;
    padding-left: 20px;
    padding-bottom: 16px;
    -unity-font-definition: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    color: rgb(0, 0, 0);
    -unity-font-style: normal;
    letter-spacing: 1px;
    text-overflow: ellipsis;
}

.RPList {
    flex-direction: column;
    width: auto;
    flex-grow: 0;
    margin-top: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
    margin-left: 24px;
    align-items: stretch;
    transition-property: left;
    transition-duration: 500s;
    transition-timing-function: ease-in-out;
    left: 0%;
}

.RPHidden {
    left: -75%;
}
