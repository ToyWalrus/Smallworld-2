:root {
}

.RPLabel {
    flex-grow: 0;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=48af136bb93de9b43a94e61c53b086ed&type=3#NotInter-Regular");
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(24, 24, 24);
    -unity-text-outline-color: rgba(255, 255, 255, 0.28);
    -unity-text-outline-width: 2px;
    white-space: pre-wrap;
}

.RPButton {
    margin-top: 12px;
    margin-bottom: 12px;
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    --bg-color: rgb(209, 150, 88);
    background-color: var(--bg-color);
}

.CenterFlex {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
