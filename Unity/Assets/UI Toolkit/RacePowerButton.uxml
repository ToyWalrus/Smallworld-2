<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameStyles.uss?fileID=7433441132597879392&amp;guid=65da4ba4461bdd047898d97d618e8b80&amp;type=3#GameStyles"/>
    <ui:Button text="" name="RPButton" class="RPButton" style="flex-grow: 1; flex-shrink: 0; flex-direction: row; justify-content: space-around; align-items: center; background-image: resource(&quot;UI-pack_Sprite_1#UI-pack_Sprite_1_67&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 40px; padding-left: 30px; padding-right: 30px; padding-bottom: 16px; width: 100%;">
        <ui:Image name="RaceTokenImage" source="project://database/Assets/Resources/racetokens.jpg?fileID=1625586068&amp;guid=283c43a1b19e42747a83d090334e00b5&amp;type=3#Token_Dwarf" style="height: 72px; width: 72px; flex-shrink: 0;"/>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: flex-end; margin-left: 30px;">
            <ui:Label text="Power" name="PowerLabel" class="RPLabel">
                <Bindings>
                    <ui:DataBinding property="text" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="Race" name="RaceLabel" class="RPLabel" style="margin-left: 8px;">
                <Bindings>
                    <ui:DataBinding property="text" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="VPBadge" style="flex-grow: 1; position: absolute; top: -10px; right: -10px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; flex-direction: row; background-image: resource(&quot;UI-pack_Sprite_1#UI-pack_Sprite_1_18&quot;); aspect-ratio: 1;">
            <ui:Label text="7" name="VPAmount" style="padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; -unity-font-style: bold; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; aspect-ratio: 1; font-size: 30px; color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
