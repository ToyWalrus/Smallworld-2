<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameStyles.uss?fileID=7433441132597879392&amp;guid=65da4ba4461bdd047898d97d618e8b80&amp;type=3#GameStyles"/>
    <ui:Button text="" name="PlayerButton" class="RPButton" style="flex-grow: 0; flex-shrink: 1; flex-direction: column; justify-content: center; align-items: flex-start; background-color: rgb(175, 88, 209);">
        <ui:Label text="Player 1" name="PlayerName" style="font-size: 32px; -unity-font-style: bold;">
            <Bindings>
                <ui:DataBinding property="text" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:Label text="Active player" name="ActiveLabel" style="font-size: 24px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 2px; display: flex; visibility: visible;">
            <Bindings>
                <ui:DataBinding property="style.visibility" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
    </ui:Button>
</ui:UXML>
